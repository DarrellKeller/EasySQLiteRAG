# Paths resolve from this repo, regardless of the shell working directory.
DATABASE_PATH=./data/rag.sqlite3
FRONTEND_DIST=./frontend/dist
EMBEDDING_PROVIDER=model2vec
EMBEDDING_MODEL=minishlab/potion-base-2M
# Rebuild document embeddings/map if the model or embedding-input setup changes.
EMBEDDING_CONFIG_ID=potion-base-2M:cosine:v1
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
LLM_PROVIDER=ollama
LLM_MODEL=granite4.2:3b
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_CONTEXT_TOKENS=8192
LLM_MAX_OUTPUT_TOKENS=768
THEME_PRIMARY=#163f3b
THEME_SECONDARY=#4059a8
# Advanced providers need an agent-implemented adapter; never put keys in VITE_ vars.
